{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.3/.schema/devbox.schema.json",
  "packages": [
    "uv@latest",
    "ruff@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "uv run pytest"
      ],
      "lint": [
        "uv run ruff check .",
        "uv run ruff format --check ."
      ],
      "format": [
        "uv run ruff format ."
      ]
    }
  }
}
